<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="Home"
        android:supportsRtl="true"
        android:theme="@style/Theme.TvHome">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- tvOS Settings. Launched from the home screen's Settings tile. -->
        <activity
            android:name=".settings.SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale"
            android:exported="false"
            android:screenOrientation="landscape"
            android:taskAffinity="com.moath.tvhome.settings" />

        <!-- Prayer lock: the adhan screen that holds the TV until after the iqama. -->
        <activity
            android:name=".prayer.PrayerLockActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":system"
            android:screenOrientation="landscape"
            android:showWhenLocked="true"
            android:taskAffinity="com.moath.tvhome.prayer"
            android:turnScreenOn="true" />

        <activity
            android:name=".assistant.AssistantActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":system"
            android:screenOrientation="landscape"
            android:taskAffinity="com.moath.tvhome.assistant"
            android:theme="@style/Theme.TvHome.Overlay"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <receiver
            android:name=".prayer.PrayerAlarmReceiver"
            android:exported="false"
            android:process=":system" />

        <!-- adb-only test hooks (DUMP is held by the shell and the system, never by apps). -->
        <receiver
            android:name=".notify.DevHooks"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:process=":system">
            <intent-filter>
                <action android:name="com.moath.tvhome.DEV_NOTICE" />
                <action android:name="com.moath.tvhome.DEV_ADHAN" />
                <action android:name="com.moath.tvhome.DEV_ADHAN_END" />
                <action android:name="com.moath.tvhome.DEV_ASK" />
                <action android:name="com.moath.tvhome.DEV_AI_PRIMARY" />
                <action android:name="com.moath.tvhome.DEV_BACK_HOLD" />
                <action android:name="com.moath.tvhome.DEV_SETTINGS" />
                <action android:name="com.moath.tvhome.DEV_STANDBY" />
                <action android:name="com.moath.tvhome.DEV_CASPER" />
                <action android:name="com.moath.tvhome.DEV_LISTEN" />
                <action android:name="com.moath.tvhome.DEV_KEYFILTER" />
                <action android:name="com.moath.tvhome.DEV_VOICEMODE" />
                <action android:name="com.moath.tvhome.DEV_PLATE" />
                <action android:name="com.moath.tvhome.DEV_SAY" />
            </intent-filter>
        </receiver>

        <!-- A football match: score, goals, lineups, channel. -->
        <activity
            android:name=".sports.MatchActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale"
            android:exported="false"
            android:screenOrientation="landscape"
            android:taskAffinity="com.moath.tvhome.match" />

        <!-- "Something stopped working": checks and one-press fixes. -->
        <activity
            android:name=".health.HealthActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="landscape"
            android:taskAffinity="com.moath.tvhome.health"
            android:theme="@style/Theme.TvHome.Overlay" />

        <!-- Surah recitation (al-Kahf on Fridays): streamed, full screen. -->
        <activity
            android:name=".quran.QuranPlayerActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:taskAffinity="com.moath.tvhome.quran" />

        <!-- tvOS Search with the linear keyboard. -->
        <activity
            android:name=".search.SearchActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale"
            android:exported="false"
            android:screenOrientation="landscape"
            android:taskAffinity="com.moath.tvhome.search"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <!-- System-wide tvOS chrome: Control Center + App Switcher, drawn as accessibility overlays. -->
        <service
            android:name=".system.SystemUiService"
            android:exported="false"
            android:process=":system"
            android:label="Apple TV Controls"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/system_ui_service" />
        </service>

        <!-- On demand: reads other apps' screens for a few seconds, then is switched off (see ScreenAccess). -->
        <service
            android:name=".system.ScreenReaderService"
            android:exported="false"
            android:label="tvhome screen reader"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:process=":system">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/screen_reader_service" />
        </service>

        <!-- Aerial screensaver. -->
        <service
            android:name=".aerial.AerialDreamService"
            android:exported="true"
            android:label="Aerial"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/aerial_dream" />
        </service>

        <!-- Prayer-times dashboard screen saver (Umm al-Qura) with weather and today's matches. -->
        <service
            android:name=".dashboard.PrayerDashboardDream"
            android:exported="true"
            android:label="مواقيت الصلاة"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/dashboard_dream" />
        </service>
    </application>
</manifest>
