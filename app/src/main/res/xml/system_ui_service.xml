<?xml version="1.0" encoding="utf-8"?>
<!--
    Always on, so it stays light: keys, overlays, screenshots. No window content: a service that can
    read other apps' views makes every Compose app (Home included) build accessibility trees each frame,
    which measured 45% janky frames on the TV. Reading screens is ScreenReaderService's job, on demand.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:canTakeScreenshot="true"
    android:description="@string/system_ui_description"
    android:notificationTimeout="100" />
